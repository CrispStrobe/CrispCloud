# Preserve PDF byte offsets and suppress text whitespace/diff handling.
test/fixtures/pdf_editor/*.pdf binary

# Preserve the exact upstream/font-metadata license text, including whitespace.
assets/licenses/pdf_fonts/*-LICENSE.txt -whitespace
assets/licenses/pdf_fonts/LPPL-1.3c.txt -whitespace

# Keep font fixture notices byte-for-byte.
packages/pdf_operations/test/fonts/*LICENSE.txt -whitespace
packages/pdf_operations/test/fonts/*.ttf binary

# Unified patch context lines contain a required space prefix.
packages/*/UPSTREAM.patch -whitespace
packages/pdf_fork_transfer/fork.patch -whitespace

# Native SMB recipe and notice hashes identify exact upstream LF bytes.
packages/dart_smb2/** text eol=lf

# Dart raw strings use LF; keep the distributed runtime notice identical.
packages/crisp_storage/NOTICE-LIBSMB2.txt text eol=lf

# Pinned document runtimes, grants and MPL source archives are hashed as bytes.
packages/file_viewer_documents/** -text -whitespace

# Catalogue provenance hashes identify exact upstream bytes on every host.
packages/crisp_catalog/** text eol=lf
cli/test/fixtures/catalog/*.caf binary
