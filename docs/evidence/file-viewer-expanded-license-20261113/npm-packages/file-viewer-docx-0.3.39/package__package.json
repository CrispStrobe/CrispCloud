{
  "name": "@file-viewer/docx",
  "version": "0.3.39",
  "description": "Pure HTML DOCX renderer fork for browser-based Word previews.",
  "license": "Apache-2.0",
  "keywords": [
    "word",
    "docx",
    "docxjs",
    "html-renderer",
    "word-preview"
  ],
  "author": {
    "name": "Volodymyr Baydalka"
  },
  "maintainers": [
    {
      "name": "Flyfish",
      "email": "wybaby168@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/docxjs.git"
  },
  "dependencies": {
    "jszip": ">=3.10.2",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "rollup": "^4.9.1",
    "@types/node": "24.19.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "terser": "^5.43.1",
    "jasmine-core": "^5.1.0",
    "playwright": "1.61.1",
    "tslib": "^2.4.0",
    "typescript": "^5.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "jsdom": "^27.4.0"
  },
  "overrides": {
    "brace-expansion": "1.1.21",
    "serialize-javascript": "7.1.3"
  },
  "scripts": {
    "build": "node scripts/clean-dist.cjs && rollup --config rollup.config.mjs && tsc --project tsconfig.build.json && node scripts/copy-build-assets.cjs",
    "build-prod": "npm run build",
    "typecheck": "tsc --noEmit --pretty false",
    "watch": "rollup --config rollup.config.mjs --watch",
    "verify": "npm run typecheck && npm run build && npm run test:regression && npm run test:package && npm run test:worker",
    "test:regression": "node scripts/run-regressions.cjs",
    "e2e": "node scripts/run-browser-specs.cjs all",
    "e2e:security": "node scripts/run-browser-specs.cjs security",
    "e2e:chart": "node scripts/run-browser-specs.cjs chart",
    "e2e:header-guard": "node scripts/run-browser-specs.cjs header-guard",
    "e2e:native-revisions": "node scripts/verify-native-revisions-browser.mjs",
    "e2e-watch": "node scripts/run-browser-specs.cjs all --watch",
    "build:rollup": "rollup --config rollup.config.mjs",
    "build-prod:rollup": "rollup --config rollup.config.mjs",
    "test:package": "node scripts/check-package.cjs",
    "e2e:worker": "node scripts/check-worker-build.cjs",
    "prepack": "npm run build",
    "test:worker": "node scripts/check-worker-protocol.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/docx-preview.js",
  "module": "./dist/docx-preview.mjs",
  "browser": "./dist/docx-preview.js",
  "unpkg": "./dist/docx-preview.min.js",
  "jsdelivr": "./dist/docx-preview.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/docx-preview-esm.d.mts",
        "default": "./dist/docx-preview.mjs"
      },
      "require": {
        "types": "./dist/docx-preview.d.ts",
        "default": "./dist/docx-preview.js"
      }
    },
    "./browser": "./dist/docx-preview.js",
    "./browser.min": "./dist/docx-preview.min.js",
    "./worker": "./dist/docx-preview.worker.js",
    "./package.json": "./package.json"
  },
  "types": "dist/docx-preview.d.ts"
}
