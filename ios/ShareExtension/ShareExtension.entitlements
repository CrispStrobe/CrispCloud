<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared App Group — must match Runner.entitlements and CrispCloudFileProvider.entitlements -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.crispcloud.shared</string>
	</array>
</dict>
</plist>
