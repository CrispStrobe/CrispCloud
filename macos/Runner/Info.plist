<dict>
	<!-- The pinned SDK's Impeller Metal surface can crash during startup.
	     Keep GPU rendering via Skia Metal until Impeller is requalified. -->
	<key>FLTEnableImpeller</key>
	<false/>
	<!-- Export compliance: intended outside-France/no-documentation route.
	     The app includes third-party and published legacy cryptography; it is
	     not OS-only. False is conditional on the complete encryption assessment,
	     historical/channel review and current availability. The distribution
	     review remains pending in docs/apple-export-policy.json. A historical
	     declaration API rejection is not approval. Before upload, verify the
	     policy and final binary; see docs/export-compliance.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
