+/// Encode a requested text value without relabelling the untouched book body.
+/// Empty values only remove metadata, so they need no text encoder.
+fn encode_metadata(value: &str, encoding: u32) -> Result<Vec<u8>, RewriteError> {
+    if value.is_empty() {
+        return Ok(Vec::new());
+    }
+    match encoding {
+        65001 => Ok(value.as_bytes().to_vec()),
+        1252 => value
+            .chars()
+            .map(|ch| {
+                let byte = match ch {
+                    '\u{0000}'..='\u{007f}' | '\u{00a0}'..='\u{00ff}' => ch as u8,
+                    '\u{20ac}' => 0x80,
+                    '\u{201a}' => 0x82,
+                    '\u{0192}' => 0x83,
+                    '\u{201e}' => 0x84,
+                    '\u{2026}' => 0x85,
+                    '\u{2020}' => 0x86,
+                    '\u{2021}' => 0x87,
+                    '\u{02c6}' => 0x88,
+                    '\u{2030}' => 0x89,
+                    '\u{0160}' => 0x8a,
+                    '\u{2039}' => 0x8b,
+                    '\u{0152}' => 0x8c,
+                    '\u{017d}' => 0x8e,
+                    '\u{2018}' => 0x91,
+                    '\u{2019}' => 0x92,
+                    '\u{201c}' => 0x93,
+                    '\u{201d}' => 0x94,
+                    '\u{2022}' => 0x95,
+                    '\u{2013}' => 0x96,
+                    '\u{2014}' => 0x97,
+                    '\u{02dc}' => 0x98,
+                    '\u{2122}' => 0x99,
+                    '\u{0161}' => 0x9a,
+                    '\u{203a}' => 0x9b,
+                    '\u{0153}' => 0x9c,
+                    '\u{017e}' => 0x9e,
+                    '\u{0178}' => 0x9f,
+                    _ => return Err(RewriteError::UnrepresentableMetadata(encoding)),
+                };
+                Ok(byte)
+            })
+            .collect(),
+        _ => Err(RewriteError::UnsupportedTextEncoding(encoding)),
+    }
+}
