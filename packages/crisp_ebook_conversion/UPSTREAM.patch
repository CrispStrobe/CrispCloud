+/// Generate only navigation targets that exist in the merged legacy stream.
+/// Blockquotes preserve EPUB nesting for MOBI6 readers that infer TOC levels
+/// from indentation. Labels remain plain text even if they contain markup.
+fn build_legacy_toc(
+    opf: &OPFData,
+    documents: &std::collections::HashMap<String, usize>,
+    anchors: &[Vec<links::Anchor>],
+    wrapper_anchors: &[std::collections::HashSet<String>],
+) -> (String, Vec<PendingFilepos>) {
+    let mut html = String::from("<h1>Contents</h1>");
+    let mut pending = Vec::new();
+    let mut depth = 0usize;
+    for point in crate::nav::parse_nav_points(opf) {
+        let Some(&file) = documents.get(&point.file_href) else {
+            continue;
+        };
+        if let Some(fragment) = &point.fragment {
+            if !anchors[file].iter().any(|anchor| &anchor.name == fragment)
+                && !wrapper_anchors[file].contains(fragment)
+            {
+                continue;
+            }
+        }
+        // Navigation must not allocate unbounded indentation for malformed
+        // input. This still covers ordinary, deeply nested book outlines.
+        let next_depth = point.depth.min(32);
+        while depth < next_depth {
+            html.push_str("<blockquote>");
+            depth += 1;
+        }
+        while depth > next_depth {
+            html.push_str("</blockquote>");
+            depth -= 1;
+        }
+        html.push_str("<p><a filepos=");
+        pending.push(PendingFilepos {
+            digits: html.len(),
+            target: Some((file, point.fragment)),
+        });
+        html.push_str("XXXXXXXXXX>");
+        html.push_str(&point.label.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;"));
+        html.push_str("</a></p>");
+    }
+    while depth > 0 {
+        html.push_str("</blockquote>");
+        depth -= 1;
+    }
+    (html, pending)
 }
 
