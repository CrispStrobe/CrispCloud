+#if TARGET_OS_IPHONE
+#include <poll.h>
+extern int crisp_take_shell_interrupt(void);
+
+void crisp_shell_check_interrupt(void)
+{
+    if (crisp_take_shell_interrupt()) {
+        // Only the interactive root is registered as interruptRoot. Never raise
+        // an OS signal: onint executes on that root at a known safe boundary.
+        exitstatus = 130;
+        exraise(EXINT);
+    }
+}
+
+ssize_t crisp_shell_read(int fd, void *buffer, size_t size)
+{
+    size_t used = 0;
+    int canonical = iflag && fd == fileno(thread_stdin) && size > 1;
+    for (;;) {
+        crisp_shell_check_interrupt();
+        struct pollfd item = { fd, POLLIN, 0 };
+        int ready = poll(&item, 1, 100);
+        if (ready < 0 && errno == EINTR) continue;
+        if (ready < 0) return -1;
+        if (ready == 0) continue;
+        crisp_shell_check_interrupt();
+        ssize_t count = read(fd, (char *)buffer + used, canonical ? 1 : size);
+        if (count <= 0) return used ? (ssize_t)used : count;
+        used += count;
+        if (!canonical || used == size || ((char *)buffer)[used - 1] == 10)
+            return (ssize_t)used;
+    }
+}
+#endif
