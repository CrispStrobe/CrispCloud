+// CrispCloud: interrupt the foreground shell without delivering a process signal.
+// The interactive Dash checks the pending flag at safe parser/evaluator boundaries.
+// Descendants are cancelled and joined by the existing owned-stream cleanup.
+pthread_t crisp_wait_owned_root(void *registration) {
+    ownedStreams *entry = registration;
+    if (!entry) return NULL;
+    pthread_mutex_lock(&ownedStreamsMutex);
+    while (entry->active && !entry->rootThread)
+        pthread_cond_wait(&entry->idle, &ownedStreamsMutex);
+    pthread_t root = entry->rootThread;
+    pthread_mutex_unlock(&ownedStreamsMutex);
+    return root;
+}
+
+int crisp_interrupt_owned_streams(void *registration, pthread_t root) {
+    ownedStreams *entry = registration;
+    if (!entry || !root) return EINVAL;
+    pthread_mutex_lock(&ownedStreamsMutex);
+    entry->interrupting = true;
+    entry->interruptRoot = root;
+    for (functionParameters *command = entry->commands; command; command = command->ownedNext) {
+        if (command->ownedThread && pthread_equal(command->ownedThread, root)) continue;
+        command->interruptCancelled = true;
+        if (command->ownedRunning) pthread_cancel(command->ownedThread);
+    }
+    pthread_mutex_unlock(&ownedStreamsMutex);
+    return 0;
+}
+
+int crisp_take_shell_interrupt(void) {
+    int pending = 0;
+    pthread_mutex_lock(&ownedStreamsMutex);
+    ownedStreams *entry = currentOwnedStreams;
+    if (entry && entry->interrupting && pthread_equal(entry->interruptRoot, pthread_self())) {
+        // Do not longjmp across a live pipeline: its descendants must finish
+        // their existing cleanup before Dash unwinds redirects and parser state.
+        bool descendants = false;
+        for (functionParameters *command = entry->commands; command; command = command->ownedNext)
+            if (!command->ownedThread || !pthread_equal(command->ownedThread, pthread_self()))
+                descendants = true;
+        if (!descendants) {
+            entry->interrupting = false;
+            pending = 1;
+        }
+    }
+    pthread_mutex_unlock(&ownedStreamsMutex);
+    return pending;
+}
