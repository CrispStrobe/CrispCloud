+# Test font
+
+`CrispPdfTestSans.ttf` is a renamed, reduced test fixture derived from the
+upstream `pdf_document/test/fonts/DejaVuSans.ttf`. It contains printable ASCII
+and selected Latin, Greek, Cyrillic, and Hebrew glyphs needed by the tests.
+It deliberately lacks other glyphs used in negative coverage tests.
+
+- Original font SHA-256: `ae7b7855e115a5966d8b1b3f80f254ccc117ec86f9965e202ee2940453837280`
+- Fixture SHA-256: `523a819ce26b5854632baec8a3be0c52d82f4d926475d51f8ca927050d5df8b0`
+- Generator: `tool/make_test_font.py`, fontTools 4.61.1
+- Original copyright/license text is retained verbatim in the adjacent
+  `DejaVu-LICENSE.txt` and `DejaVuSans-font-metadata-LICENSE.txt` notices.
+
+The test font is not shipped as an application font. Do not infer general
+language coverage from this intentionally limited test fixture.
diff --git a/packages/pdf_operations/test/page_range_test.dart b/packages/pdf_operations/test/page_range_test.dart
new file mode 100644
index 0000000..9295048
--- /dev/null
+++ b/packages/pdf_operations/test/page_range_test.dart
@@ -0,0 +1,45 @@
+import 'package:pdf_operations/pdf_operations.dart';
+import 'package:test/test.dart';
+
+void main() {
+  test('ranges retain requested order and use one-based inclusive notation',
+      () {
+    expect(PdfPageRange.parse(' 4-2, 1 ', 4), [3, 2, 1, 0]);
+    expect(PdfPageRange.parse('1-3,7', 8), [0, 1, 2, 6]);
+    expect(PdfPageRange.parse('ALL', 3), [0, 1, 2]);
+  });
+
+  for (final expression in [
+    '',
+    '0',
+    '1-5',
+    '1,1',
+    '1-3,2',
+    '-1',
+    '1,,2',
+    '2-',
+    'all,1',
+    '1.5',
+    '999999999999999999999999999999999'
+  ]) {
+    test('rejects invalid selection $expression', () {
+      expect(
+          () => PdfPageRange.parse(expression, 4),
+          throwsA(isA<PdfOperationException>()
+              .having((e) => e.code, 'code', 'invalidPages')));
+    });
+  }
+
+  test('explicit duplication opt-in does not change normal workflow policy',
+      () {
+    expect(PdfPageRange.parse('2,2', 3, allowDuplicates: true), [1, 1]);
+    expect(() => PdfPageRange.parse('2,2', 3),
+        throwsA(isA<PdfOperationException>()));
+  });
+
+  test('no zero-page selection and returned indices are immutable', () {
+    expect(() => PdfPageRange.parse('all', 0),
+        throwsA(isA<PdfOperationException>()));
+    expect(() => PdfPageRange.parse('all', 2).add(2), throwsUnsupportedError);
+  });
+}
diff --git a/packages/pdf_operations/test/service_test.dart b/packages/pdf_operations/test/service_test.dart
new file mode 100644
index 0000000..02bed11
--- /dev/null
+++ b/packages/pdf_operations/test/service_test.dart
@@ -0,0 +1,645 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:pdf_cos/pdf_cos.dart';
+import 'package:pdf_document/pdf_document.dart';
+import 'package:pdf_graphics/pdf_graphics.dart';
+import 'package:pdf_operations/pdf_operations.dart';
+import 'package:pdf_test_fixtures/pdf_test_fixtures.dart';
+import 'package:test/test.dart';
+
+import 'support/fixtures.dart';
+
+Matcher code(String value) =>
+    isA<PdfOperationException>().having((error) => error.code, 'code', value);
+
+void main() {
+  const service = PdfOperationsService();
+  late Uint8List fontBytes;
+  setUpAll(() {
+    fontBytes = File('test/fonts/CrispPdfTestSans.ttf').readAsBytesSync();
+  });
+
+  group('inspection and snapshot ownership', () {
+    test('schema includes form metadata and visual page sizes', () {
+      final result = service.inspect(PdfInput(workflowPdf()));
+      expect(result.pageCount, 3);
+      expect(result.encrypted, isFalse);
+      expect(
+          result.fields
+              .firstWhere((field) => field.name == 'interests')
+              .multiSelect,
+          isTrue);
+      final choice =
+          result.fields.firstWhere((field) => field.name == 'delivery');
+      expect(choice.options.map((option) => option.value),
+          ['standard', 'express']);
+      expect(choice.options.map((option) => option.label),
+          ['Standard', 'Express']);
+      expect(result.pages.first.pageIndex, 0);
+      expect(result.pages.first.toJson()['page'], 1);
+      final geometry = service.inspect(PdfInput(geometryPdf()));
+      expect(
+          (geometry.pages[0].width, geometry.pages[0].height), (300.0, 400.0));
+      expect(
+          (geometry.pages[1].width, geometry.pages[1].height), (400.0, 300.0));
+      expect(geometry.pages.map((page) => page.rotation), [0, 90, 180, 270]);
+    });
+
+    test('inspection never exposes historical password-field values', () {
+      final result = service
+          .inspect(PdfInput(restrictedFormPdf(), password: 'not-serialized'));
+      final field =
+          result.fields.firstWhere((field) => field.name == 'password');
+      expect(field.password, isTrue);
+      expect(field.values, isEmpty);
+      expect(jsonEncode(result.toJson()),
+          isNot(contains('historical-test-password')));
+      expect(jsonEncode(result.toJson()), isNot(contains('not-serialized')));
+    });
+
+    test('input/result bytes cannot mutate an earlier snapshot', () {
+      final bytes = workflowPdf();
+      final originalFirst = bytes.first;
+      final input = PdfInput(bytes);
+      bytes[0] = 0;
+      expect(input.bytes.first, originalFirst);
+      expect(() => input.bytes[0] = 0, throwsUnsupportedError);
+      final result = service.rotate(input, pages: '1');
+      expect(() => result.bytes[0] = 0, throwsUnsupportedError);
+      expect(service.inspect(input).pages.first.rotation, 0);
+      expect(service.inspect(PdfInput(result.bytes)).pages.first.rotation, 90);
+    });
+  });
+
+  group('page workflows', () {
+    test('ordered merge imports functional forms and renames colliding roots',
+        () {
+      final result = service.merge([
+        PdfMergeInput(PdfInput(workflowPdf(label: 'A')), pages: '3,1,2'),
+        PdfMergeInput(PdfInput(workflowPdf(label: 'B')), pages: '2,1'),
+      ]);
+      expect(result.pageCount, 5);
+      final text = service.text(PdfInput(result.bytes));
+      expect(text.map((page) => page.text.trim()), [
+        'A page 3',
+        'A page 1',
+        'A page 2',
+        'B page 2',
+        'B page 1',
+      ]);
+      final document = PdfDocument.open(result.bytes);
+      final form = PdfAcroForm.of(document)!;
+      expect(
+          form.fields.where((field) => field.type == PdfFieldType.text).length,
+          4);
+      expect(form.fields.map((field) => field.name).toSet().length,
+          form.fields.length);
+      final secondImported =
+          form.fields.where((field) => field.name.startsWith('second_')).single;
+      final filled = service.fillForm(PdfInput(result.bytes),
+          values: {secondImported.name: 'Still editable'});
+      final reread = PdfAcroForm.of(PdfDocument.open(filled.bytes))!;
+      expect(reread.fieldNamed(secondImported.name)!.value, 'Still editable');
+    });
+
