          }
        ]
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://learn.microsoft.com/en-us/office/vba/api/powerpoint.textrange.text",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_MACROS.md",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_POWERPOINT_MACROS.md"
        ],
        "note": "Source member names are case-insensitive; a literal tab and complete UTF-16 surrogate pair survive native JSON publication. No Office host was executed."
      }
    },
    {
      "id": "reject-zero-slide-index",
      "feature": "One-based index refusal",
      "source": "Sub Main()\n  ActivePresentation.Slides(0).Shapes(1).TextFrame.TextRange.Text = \"x\"\nEnd Sub\n",
      "expected": {
        "diagnostic": {
          "code": "vba_type_error",
          "line": 2,
          "column": 22
        }
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://learn.microsoft.com/en-us/office/vba/api/powerpoint.slides.item",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_POWERPOINT_MACROS.md"
        ],
        "note": "Zero cannot address a slide; this value-dependent refusal is attached to the Slides selector. No Office host was executed."
      }
    },
    {
      "id": "reject-boolean-shape-index",
      "feature": "Selector static type restriction",
      "source": "Sub Main()\n  ActivePresentation.Slides(1).Shapes(True).TextFrame.TextRange.Text = \"x\"\nEnd Sub\n",
      "expected": {
        "diagnostic": {
          "code": "vba_type_error",
          "line": 2,
          "column": 39
        }
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_POWERPOINT_MACROS.md"
        ],
        "note": "Boolean selectors are refused statically rather than coerced to a number or a name; the argument token owns the diagnostic. No Office host was executed."
      }
    },
    {
