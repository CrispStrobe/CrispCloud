      "expected": {
        "diagnostic": {
          "code": "vba_type_error",
          "line": 2,
          "column": 67
        }
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://learn.microsoft.com/en-us/office/vba/api/powerpoint.font.bold",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_POWERPOINT_MACROS.md"
        ],
        "note": "Mixed formatting is an inspection state, not a supported source write. Only Boolean, msoTrue and msoFalse writes are admitted. No Office host was executed."
      }
