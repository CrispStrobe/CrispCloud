    },
    {
      "id": "unicode-tab-and-case-insensitive-members",
      "feature": "UTF-16 text and case-insensitive source names",
      "source": "Sub Main()\n  activepresentation.slides(1).shapes(1).textframe.textrange.text = \"A\t\" & Mid$(\"😀\", 1, 2)\nEnd Sub\n",
