      "id": "raise-three",
      "feature": "Font.Position",
      "source": "Sub Main()\n  ActiveDocument.Paragraphs(1).Range.Font.Position = 3\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.runFormat",
            "arguments": {
              "paragraph": 0,
              "position": 3
            }
          }
        ]
      },
      "provenance": {
        "kind": "spec-derived",
        "references": [
          "https://learn.microsoft.com/en-us/office/vba/api/word.font.position",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md#baseline-position-without-resizing-text"
        ],
        "note": "Microsoft defines signed Long point displacement; the adapter preserves its paragraph selector. No installed Office host was executed."
      }
