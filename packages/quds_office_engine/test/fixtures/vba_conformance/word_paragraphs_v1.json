    {
      "id": "nullable-conditions-and-select-case",
      "feature": "Shared conditional control flow",
      "source": "Sub Main()\n  Dim value As Variant\n  value = Null\n  If value Then\n    ThisDocument.Paragraphs(1).Range.InsertBefore \"unreachable\"\n  Else\n    ThisDocument.Paragraphs(1).Range.InsertBefore \"null\"\n  End If\n  value = Empty\n  If value Then\n    ThisDocument.Paragraphs(1).Range.InsertBefore \"unreachable\"\n  Else\n    ThisDocument.Paragraphs(1).Range.InsertBefore \"empty\"\n  End If\n  Select Case 2\n    Case 1\n      ThisDocument.Paragraphs(1).Range.InsertBefore \"unreachable\"\n    Case 2\n      ThisDocument.Paragraphs(1).Range.InsertBefore \"selected\"\n  End Select\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "null"
            }
          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "empty"
            }
          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "selected"
            }
          }
        ]
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_MACROS.md"
        ],
        "note": "The shared dialect treats Empty and Null conditions as false and retains deterministic Select Case execution. No Office host was executed."
      }
    },
