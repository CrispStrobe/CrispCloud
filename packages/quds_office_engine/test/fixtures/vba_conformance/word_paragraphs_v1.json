{
  "schemaVersion": 1,
  "suite": "vba-word-paragraphs",
  "dialect": "vba-word",
  "cases": [
    {
      "id": "insertbefore-first-paragraph",
      "feature": "Paragraph prefix insertion",
      "source": "Sub Main()\n  ThisDocument.Paragraphs(1).Range.InsertBefore \"Hello \"\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "Hello "
            }
          }
        ]
      },
      "provenance": {
        "kind": "spec-derived",
        "references": [
          "https://learn.microsoft.com/en-us/office/vba/api/word.range.insertbefore",
          "https://learn.microsoft.com/en-us/office/vba/api/word.paragraph.range",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md"
        ],
        "note": "The first paragraph range receives a prefix; the adapter lowers the one-based selector to native paragraph zero. No Office host was executed."
      }
    },
    {
      "id": "document-paragraph-range-aliases-byval",
      "feature": "Object bindings",
      "source": "Sub Stamp(ByVal doc As Document, ByVal para As Paragraph, ByVal target As Range)\n  doc.Paragraphs(1).Range.InsertBefore \"D\"\n  para.Range.InsertBefore \"P\"\n  target.InsertBefore \"R\"\nEnd Sub\nSub Main()\n  Dim doc As Document, para As Paragraph, target As Range\n  Set doc = ThisDocument\n  Set para = doc.Paragraphs(2)\n  Set target = doc.Paragraphs(3).Range\n  Call Stamp(doc, para, target)\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "D"
            }
          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 1,
              "start": 0,
              "end": 0,
              "text": "P"
            }
          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 2,
              "start": 0,
              "end": 0,
              "text": "R"
            }
          }
        ]
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md"
        ],
        "note": "Set and explicit ByVal preserve each supported Word object selector without live document access. No Office host was executed."
      }
    },
    {
      "id": "insertbefore-call-forms-and-empty-text",
      "feature": "Method statements",
      "source": "Sub Main()\n  Dim target As Range\n  Set target = ThisDocument.Paragraphs(1).Range\n  target.InsertBefore \"A\"\n  target.InsertBefore(\"B\")\n  Call target.InsertBefore(\"C\")\n  target.InsertBefore \"\"\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "A"
