      "source": "Sub Main()\n  Dim value As Variant, target As Range\n  Set target = ThisDocument.Paragraphs(1).Range\n  target.InsertBefore CStr(IsEmpty(value))\n  value = Null\n  target.InsertBefore CStr(IsNull(value))\n  target.InsertBefore CStr(CLng(2.5)) & \":\" & Mid$(\"prefix\", 2, 3)\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "True"
            }
          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "True"
