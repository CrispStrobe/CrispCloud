    {
      "id": "alignment-constants-const-array-bounds",
      "feature": "Word constants and arrays",
      "source": "Const LastAlignment As Long = wdAlignParagraphJustify\nSub Main()\n  Dim values(wdAlignParagraphLeft To LastAlignment) As Long, i As Long\n  values(0) = wdAlignParagraphLeft\n  values(1) = wdAlignParagraphCenter\n  values(2) = wdAlignParagraphRight\n  values(3) = wdAlignParagraphJustify\n  For i = LBound(values) To UBound(values)\n    ThisDocument.Paragraphs(1).Range.ParagraphFormat.Alignment = values(i)\n  Next i\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.paragraphFormat",
            "arguments": {
              "paragraph": 0,
              "alignment": "left"
            }
          },
          {
            "tool": "docx.paragraphFormat",
            "arguments": {
              "paragraph": 0,
              "alignment": "center"
            }
          },
          {
            "tool": "docx.paragraphFormat",
            "arguments": {
              "paragraph": 0,
              "alignment": "right"
            }
          },
          {
            "tool": "docx.paragraphFormat",
            "arguments": {
              "paragraph": 0,
              "alignment": "justify"
            }
          }
        ]
      },
      "provenance": {
        "kind": "spec-derived",
        "references": [
          "https://learn.microsoft.com/en-us/office/vba/api/word.wdparagraphalignment",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md"
        ],
        "note": "The four admitted Word enumeration constants retain values zero through three and may appear in scalar Const expressions and fixed array bounds. No Office host was executed."
      }
    },
