          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "B"
            }
          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": "C"
            }
          },
          {
            "tool": "docx.replaceText",
            "arguments": {
              "paragraph": 0,
              "start": 0,
              "end": 0,
              "text": ""
            }
          }
        ]
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md"
        ],
        "note": "The three supported method statement forms retain emission order; an empty actual String is admitted. No Office host was executed."
      }
    },
    {
      "id": "nested-with-font-and-paragraph-format",
      "feature": "Formatting paths",
      "source": "Sub Main()\n  With ThisDocument\n    With .Paragraphs(3)\n      With .Range\n        With .Font\n          .Bold = True\n          .Italic = False\n          .Size = 11.5\n          .Name = \"Arial\"\n          .Color = RGB(17, 34, 51)\n        End With\n        With .ParagraphFormat\n          .Alignment = wdAlignParagraphCenter\n          .SpaceBefore = 0\n          .SpaceAfter = 12.5\n        End With\n      End With\n    End With\n  End With\nEnd Sub\n",
      "expected": {
        "steps": [
          {
            "tool": "docx.runFormat",
            "arguments": {
              "paragraph": 2,
              "bold": true
            }
          },
          {
            "tool": "docx.runFormat",
            "arguments": {
              "paragraph": 2,
              "italic": false
            }
          },
          {
            "tool": "docx.runFormat",
            "arguments": {
              "paragraph": 2,
              "size": 11.5
            }
          },
          {
            "tool": "docx.runFormat",
            "arguments": {
              "paragraph": 2,
              "font": "Arial"
            }
          },
          {
            "tool": "docx.runFormat",
            "arguments": {
              "paragraph": 2,
              "color": "112233"
            }
          },
          {
            "tool": "docx.paragraphFormat",
            "arguments": {
              "paragraph": 2,
              "alignment": "center"
            }
          },
          {
            "tool": "docx.paragraphFormat",
            "arguments": {
              "paragraph": 2,
              "before": 0
            }
          },
          {
            "tool": "docx.paragraphFormat",
            "arguments": {
              "paragraph": 2,
              "after": 12.5
            }
          }
        ]
      },
      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md"
        ],
        "note": "Nested With resolves supported typed objects; formatting targets current native paragraph text, excluding a Word paragraph mark. No Office host was executed."
      }
    },
