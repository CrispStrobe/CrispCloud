      "provenance": {
        "kind": "dialect-contract",
        "references": [
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_WORD_MACROS.md",
          "https://github.com/CrispStrobe/quds_office_suite/blob/main/docs/VBA_MACROS.md"
        ],
        "note": "Word uses the same explicit Variant states, ties-to-even conversion, invariant formatting and strict String intrinsics as the shared source language. No Office host was executed."
      }
    },
