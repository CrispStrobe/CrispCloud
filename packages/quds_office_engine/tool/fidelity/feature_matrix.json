{
  "version": 1,
  "features": {
    "footnotes": {
      "description": "Rich footnote import/edit/export, markers, identity, pagination and repeated saves.",
      "bundles": [
        "base-word",
        "notes",
        "note-markers"
      ],
      "goldens": [
        "word-page",
        "layout"
      ]
    },
    "endnotes": {
      "description": "Endnote stories, markers, source ownership and repeated-save preservation.",
      "bundles": [
        "base-word",
        "notes",
        "note-markers"
      ],
      "goldens": [
        "word-page"
      ]
    },
    "headings": {
      "description": "Heading levels, style references and native contents through scripted edits.",
      "bundles": [
        "base-word",
        "scripted",
        "structure"
      ],
      "goldens": [
        "word-page",
        "structure"
      ]
    },
    "styles": {
      "description": "Sparse inherited paragraph/character/table styles and explicit run formatting.",
      "bundles": [
        "styles",
        "scripted"
      ],
      "goldens": [
        "word-page",
        "structure"
      ]
    },
    "paragraphs": {
      "description": "Text replacement, splitting, insertion, deletion, spacing, tabs, lists and breaks.",
      "bundles": [
        "base-word",
        "scripted",
        "structure"
      ],
      "goldens": [
        "layout",
        "structure"
      ]
    },
    "images": {
      "description": "Picture bytes, size, replacement and relationships in body, headers, footers and notes.",
      "bundles": [
        "story-media",
        "image-replacement",
        "scripted"
      ],
      "goldens": [
        "stories",
        "structure"
      ]
    },
    "tables": {
      "description": "Create/edit/remove grids, rich merged cells, logical selectors, inherited borders and nested layout.",
      "bundles": [
        "structure",
        "table-borders",
        "table-grid"
      ],
      "goldens": [
        "layout",
        "structure",
        "nested-tables",
        "table-grid"
      ]
    },
    "tocs": {
      "description": "Native TOC creation, refresh/removal and heading bookmark links.",
      "bundles": [
        "structure"
      ],
      "goldens": [
        "structure"
      ]
    },
    "textflow": {
      "description": "Paragraph flow, columns, continued notes and positioned frame exclusions.",
      "bundles": [
        "base-word",
        "notes",
        "frames",
        "structure"
      ],
      "goldens": [
        "layout",
        "frames"
      ]
    },
    "placement": {
      "description": "Drawing coordinates, dimensions, wrap distances and owning story placement.",
      "bundles": [
        "frames",
        "story-media",
        "structure",
        "slide-arrange"
      ],
      "goldens": [
        "frames",
        "stories",
        "structure"
      ]
    },
    "drawings": {
      "description": "Native text frames, DrawingML outlines and square/top-bottom wrapping.",
      "bundles": [
        "frames",
        "structure",
        "slide-arrange"
      ],
      "goldens": [
        "frames",
        "structure"
      ]
    },
    "references": {
      "description": "Bookmarks, complete native-range insertion copies, native REF/inline fields, citations, bibliography and target ownership.",
      "bundles": [
        "bookmarks",
        "bibliography",
        "inline-fields",
        "structure",
        "bookmark-copy"
      ],
      "goldens": [
        "structure"
      ]
    },
    "comments": {
      "description": "Anchors, thread replies, edits, resolution and deletion through repeated saves.",
      "bundles": [
        "comments",
        "structure"
      ],
      "goldens": [
        "structure"
      ]
    },
    "spreadsheets": {
      "description": "Scripted cells/styles/formulas, native workbook/pivot retention, scoped defined-name recalculation and atomic sheet rename.",
      "bundles": [
        "scripted",
        "native-sheets-slides",
        "cross-format",
        "sheet-rename",
        "sheet-qualified-names"
      ],
      "goldens": []
    },
    "slides": {
      "description": "Scripted shapes/notes/geometry/transitions, endpoint-stable arrangement, collision-free flat grouping, native templates and section-preserving reordering.",
      "bundles": [
        "scripted",
        "native-sheets-slides",
        "cross-format",
        "slide-sections",
        "slide-arrange"
      ],
      "goldens": []
    }
  },
