{
  "rewrites": [
    {
      "source": "/api/internxt-drive/:path*",
      "destination": "https://gateway.internxt.com/drive/:path*"
    },
    {
      "source": "/api/internxt-network/:path*",
      "destination": "https://gateway.internxt.com/network/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}